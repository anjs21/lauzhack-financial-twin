# Laptop only. Never put these keys in web/ or a VITE_* variable.
TWIN_API_KEY=
TOGETHER_API_KEY=
# A chat model id from your Together AI account: https://api.together.ai/models
TOGETHER_MODEL=
# Optional, defaults to https://api.together.xyz/v1
# TOGETHER_BASE_URL=
# Comma-separated exact frontend origins (no trailing slash).
TWIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
